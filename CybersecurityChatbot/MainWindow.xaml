<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityChatbot"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness ChatBot" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F0F2F5">

        <!-- 
            HOME GRID - Landing page with logo and welcome message
        -->
        <Grid x:Name="home_grid" Visibility="Visible" Background="#F0F2F5">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Image Source="logo.jpeg" Height="180" Width="270" Margin="0,0,0,20"/>

                <!-- Welcome message -->
                <TextBlock
                    Text="Welcome to Cybersecurity Awareness ChatBot"
                    Height="30"
                    Width="350"
                    TextAlignment="Center"
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    FontFamily="Segoe UI"
                    Foreground="#1a3a5c"/>

                <TextBlock
                    Text="Protecting People Online"
                    Height="20"
                    Width="350"
                    TextAlignment="Center"
                    Margin="0,0,0,30"
                    FontSize="12"
                    FontFamily="Segoe UI"
                    Foreground="#666666"/>

                <!-- Button to continue -->
                <Button 
                    Height="45"
                    Width="200"
                    Content="Proceed"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#2C7BE5"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="proceed"/>
            </StackPanel>
        </Grid>

        <!-- 
            USERNAME GRID - Prompt user for their name
        -->
        <Grid x:Name="username_grid" Visibility="Hidden" Background="#F0F2F5">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Image Source="logo.jpeg" Height="150" Width="225" Margin="0,0,0,20"/>

                <!-- Hint message -->
                <TextBlock
                    Text="Please enter your name"
                    Height="25"
                    Width="300"
                    TextAlignment="Center"
                    Margin="0,0,0,15"
                    FontSize="14"
                    FontWeight="Bold"
                    FontFamily="Segoe UI"
                    Foreground="#1a3a5c"/>

                <!-- Enter/Prompt username -->
                <TextBox
                    Height="42"
                    Width="280"
                    TextAlignment="Center"
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontFamily="Segoe UI"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    x:Name="usernames_input"/>

                <!-- Error message -->
                <TextBlock
                    Text="Please enter a valid name to continue"
                    Height="20"
                    Width="300"
                    TextAlignment="Center"
                    Margin="0,0,0,15"
                    Foreground="Red"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Visibility="Collapsed"
                    x:Name="error_message"/>

                <!-- Button to submit name -->
                <Button 
                    Height="42"
                    Width="200"
                    Content="Submit"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#2C7BE5"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="submit_name"/>
            </StackPanel>
        </Grid>

        <!-- 
            CHAT GRID - Main conversation area
        -->
        <Grid x:Name="chat_grid" Visibility="Hidden" Background="#F0F2F5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1a3a5c" Padding="10,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Image Source="/logo.jpeg" Height="35" Width="50" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Cybersecurity Awareness Bot" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   FontFamily="Segoe UI"/>
                        <TextBlock x:Name="user_display" 
                                   Text="" 
                                   FontSize="10" 
                                   Foreground="#AAAAAA"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Chat ListView -->
            <ListView  
                x:Name="chats" 
                Grid.Row="1"
                Margin="10,10,10,10"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                FontFamily="Segoe UI"/>

            <!-- Input area -->
            <Border Grid.Row="2" Background="White" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- TextBox for questions -->
                    <TextBox
                        x:Name="question"
                        Height="45"
                        VerticalContentAlignment="Center"
                        FontSize="13"
                        FontFamily="Segoe UI"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Padding="10,0,10,0"
                        KeyDown="question_KeyDown"/>

                    <!-- Send button -->
                    <Button
                        Grid.Column="1"
                        Height="45"
                        Width="80"
                        Margin="10,0,0,0"
                        Content="Send"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Background="#2C7BE5"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="send"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
